# ── Environment ──
ENVIRONMENT=development
# PRODUCTION için: ENVIRONMENT=production yapın

# ── Database ──
# Local kurulum: postgresql+asyncpg://user:password@localhost:5432/dbname
DATABASE_URL=postgresql+asyncpg://your_db_user:your_db_password@localhost:5432/sehriminuzmani

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# ── Security ──
# openssl rand -hex 32 komutu ile üretebilirsiniz
SECRET_KEY=your_super_secret_key_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI (OpenRouter) ──
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.5-flash

# ── Payment (Iyzico vs - Gelecek için) ──
PAYMENT_API_KEY=
PAYMENT_SECRET_KEY=

# ── Email / SMTP (Gelecek için) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
