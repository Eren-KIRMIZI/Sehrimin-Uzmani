# Uygulama Ortamı: development | staging | production
ENVIRONMENT=development
APP_NAME=SehrininUzmani
APP_VERSION=1.0.0
DEBUG=false

# Güvenlik — production'da en az 64 karakterlik rastgele string kullanın
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_to_a_random_64_character_string

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL
DATABASE_URL=postgresql+psycopg2://sehrim_admin:CHANGE_ME@localhost:5432/sehriminuzmani

# Redis / Memurai
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# CORS — production'da gerçek domain'inizi yazın
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Dosya Yükleme
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# OpenRouter AI (https://openrouter.ai → API Keys)
OPENROUTER_API_KEY=sk-or-CHANGE_ME
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
